[Unit]
Description=Dispatch Sensex Noise worker command requests
Documentation=file:/opt/sensex-noise/deploy/README.md
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=sensexbot
WorkingDirectory=/opt/sensex-noise
Environment=TZ=Asia/Kolkata
ExecStart=/opt/sensex-noise/deploy/scripts/worker_command_dispatch.sh
